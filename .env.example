APP_NAME="TaskFlow"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran
APP_KEY=replace-with-a-random-64-character-secret
APP_LOCALE=fa

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taskflow
DB_USER=
DB_PASS=
DB_TABLE_PREFIX=app_

# Project module
APP_MODULES=workflow

AUTH_ALLOW_REGISTRATION=true
AUTH_SESSION_KEY=app_user_id

MAIL_DRIVER=disabled
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="TaskFlow"

PAYMENT_DRIVER=disabled
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

UPLOAD_MAX_IMAGE_BYTES=5000000
